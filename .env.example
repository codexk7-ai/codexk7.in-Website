# Copy to .env (never commit .env). Server-only secrets: never prefix with VITE_.

# Where contact-form leads are forwarded (CRM, Zapier/Make, Slack, Google Sheets
# via Apps Script, or your own endpoint). Required for the contact form to work.
LEAD_WEBHOOK_URL=

# Public build-time settings (VITE_ values are visible in the browser; never put secrets here).
# Full site URL used for absolute Open Graph image links, e.g. https://codexk7.example
VITE_SITE_URL=
# Optional: Plausible domain for privacy-friendly analytics. Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
